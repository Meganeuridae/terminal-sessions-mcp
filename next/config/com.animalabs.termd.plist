<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd: cp to ~/Library/LaunchAgents/, then replace the two paths below (writing & as &amp;
     and < as &lt;):
       PACKAGE  the installed package: "$(npm root -g)/term-sessions-mcp", or with Volta
                ~/.volta/tools/image/packages/term-sessions-mcp/lib/node_modules/term-sessions-mcp
       /Users/YOU  your home directory (launchd does not expand ~ or $HOME)
     and start it:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.animalabs.termd.plist
     termd-launch.sh finds node (Volta, Homebrew, /usr/local, nvm's default version; or
     TSM_NODE_BIN=/path/to/node in EnvironmentVariables), puts those directories on PATH and
     starts in $HOME. termd logs to stderr, kept in the file below. No Umask: the sessions'
     shells inherit the mask, so files a session creates keep the usual permissions.
     ExitTimeOut gives the daemon 20 s from SIGTERM to SIGKILL, as termd.service's TimeoutStopSec does: its stop gives
     every session's close that long, counted from when it handles the signal, so a SIGKILL can land as a close's last
     steps run. Its log names each close as it begins, so one cut short has no line saying how it ended. Without it, launchd's default applies, which was 5 s on macOS 15 and 26. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.animalabs.termd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>PACKAGE/next/config/termd-launch.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/termd.stderr.log</string>
</dict>
</plist>
