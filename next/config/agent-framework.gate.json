{
  "policies": [
    {
      "name": "terminal-wakes",
      "match": { "source": "terminal", "tagsAny": ["terminal:run-finished", "terminal:run-lost", "terminal:needs-input", "terminal:watch", "terminal:session-exited", "terminal:service-*", "terminal:recovered", "terminal:missed", "terminal:human-input"] },
      "behavior": "always"
    },
    {
      "name": "terminal-ambient",
      "match": { "source": "terminal", "tagsAny": ["terminal:output", "terminal:screen", "terminal:control"] },
      "behavior": { "debounce": 30000 }
    }
  ]
}
