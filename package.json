{
  "name": "term-sessions-mcp",
  "version": "1.6.0",
  "description": "Persistent terminal sessions for agents and humans: a daemon with a journal, shell integration, MCP and MCPL.",
  "main": "next/dist/src/index.js",
  "types": "next/dist/src/index.d.ts",
  "bin": {
    "termd": "./next/dist/src/daemon.js",
    "tsm": "./next/dist/src/cli/tsm.js",
    "tsm-shim": "./next/dist/src/shim/stdio.js",
    "terminal-sessions-mcp": "./next/dist/src/shim/compat.js",
    "session-server": "./next/dist/src/daemon.js"
  },
  "scripts": {
    "build": "tsc -p next/tsconfig.json",
    "test": "npm run build && node --test \"next/dist/spec/**/*.spec.js\"",
    "build:next": "npm run build",
    "test:next": "npm test",
    "acceptance:af": "npm run build && node next/acceptance/agent-framework.mjs",
    "acceptance:bridge": "npm run build && bun next/acceptance/bridge.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const p=path.join(path.dirname(require.resolve('node-pty/package.json')),'build/Release/spawn-helper');fs.chmodSync(p,0o755);}catch(e){}\""
  },
  "keywords": [
    "agents",
    "ai",
    "assistant",
    "mcp",
    "mcpl",
    "persistent",
    "pty",
    "session",
    "shell",
    "terminal"
  ],
  "author": "Anima Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antra-tess/terminal-sessions-mcp.git"
  },
  "dependencies": {
    "@animalabs/mcpl-core": "0.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "puppeteer": "^24.29.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "files": [
    "next/dist/src",
    "next/gui",
    "next/config",
    "next/package.json",
    "next/README.md",
    "docs/redesign/DESIGN.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
