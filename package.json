{
  "name": "term-sessions-mcp",
  "version": "1.7.3",
  "description": "Persistent terminal session management with MCP integration for AI assistants",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "terminal-sessions-mcp": "./dist/src/mcp/mcp-stdio-server.js",
    "session-server": "./dist/src/server/start-session-server.js",
    "session-cli": "./dist/cli/session-cli.js",
    "termd": "./next/dist/src/daemon.js",
    "tsm": "./next/dist/src/cli/tsm.js",
    "tsm-relay": "./next/dist/src/relay.js"
  },
  "scripts": {
    "build": "tsc && npm run build:next",
    "test": "npm run build && node --test",
    "dev": "tsc --watch",
    "start": "node dist/src/server/start-session-server.js",
    "start-server": "ts-node src/server/start-session-server.ts",
    "start-headless": "ts-node src/server/start-session-server.ts --headless",
    "mcp-server": "ts-node src/mcp/mcp-stdio-server.ts",
    "cli": "ts-node cli/session-cli.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/pty-permissions.js",
    "build:next": "node -e \"require('node:fs').rmSync('next/dist', { recursive: true, force: true })\" && tsc -p next/tsconfig.json",
    "test:next": "npm run build && node --test next/dist/spec/*.spec.js",
    "acceptance:af": "npm run build:next && node next/acceptance/agent-framework.mjs",
    "acceptance:bridge": "npm run build:next && bun next/acceptance/bridge.ts"
  },
  "keywords": [
    "mcp",
    "terminal",
    "session",
    "ai",
    "assistant",
    "pty",
    "shell",
    "persistent"
  ],
  "author": "Anima Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antra-tess/terminal-sessions-mcp.git"
  },
  "dependencies": {
    "@animalabs/mcpl-core": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@xterm/headless": "6.0.0",
    "node-pty": "^1.0.0",
    "strip-ansi": "^7.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  }
}
